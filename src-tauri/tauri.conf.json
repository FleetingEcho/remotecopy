{
  "productName": "RemoteCopy",
  "version": "0.1.5",
  "identifier": "com.remotecopy.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RemoteCopy",
        "width": 840,
        "height": 640,
        "minWidth": 600,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "deb", "appimage"],
    "resources": [],
    "icon": [
      "icon/32x32.png",
      "icon/128x128.png",
      "icon/128x128@2x.png",
      "icon/icon.ico"
    ]
  }
}
